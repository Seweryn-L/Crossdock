# Demo deployment for Docker Compose / Oracle VM.
# Copy to `.env` on the server and fill in the secrets.

# Required: session signing secret for NiceGUI cookies.
# Generate, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"
CROSSDOCK_STORAGE_SECRET=

# Required on first boot against an empty DB.
CROSSDOCK_ADMIN_PASSWORD=

CROSSDOCK_DB_PATH=data/crossdock.db
# On Windows Docker Desktop, if ./data/crossdock.db is locked by a local process,
# use a separate file instead, e.g. CROSSDOCK_DB_PATH=data/demo/crossdock_demo.db
CROSSDOCK_HOST=0.0.0.0
CROSSDOCK_PORT=8080

CROSSDOCK_SESSION_MAX_IDLE_MINUTES=60
CROSSDOCK_DEFAULT_DELIVERY_DAYS=7
CROSSDOCK_SHIP_LEAD_DAYS=2
CROSSDOCK_WAREHOUSE_CAPACITY_KG=50000

CROSSDOCK_EXCEL_MAPPING_PATH=config/excel_column_mapping.json
CROSSDOCK_UPLOAD_MAX_MB=20

CROSSDOCK_DEPOT_LATITUDE=51.176
CROSSDOCK_DEPOT_LONGITUDE=4.836
CROSSDOCK_MIN_FILL_RATIO=0.90
CROSSDOCK_MAX_DROPS_PER_ROUTE=3
CROSSDOCK_SOLVER_TIME_LIMIT_S=45
CROSSDOCK_SOLVER_SEED=42

CROSSDOCK_COST_PER_KM=1.2
CROSSDOCK_BUFFER_SAVINGS_THRESHOLD=0.15
CROSSDOCK_STORAGE_COST_PER_PALLET_DAY=2.0
CROSSDOCK_LTL_COST_MULTIPLIER=1.8
CROSSDOCK_MAX_BUFFER_DAYS=3

CROSSDOCK_BACKUP_DIR=data/backups
CROSSDOCK_BACKUP_KEEP=14
CROSSDOCK_BACKUP_HOUR=2
CROSSDOCK_BACKUP_MINUTE=30
