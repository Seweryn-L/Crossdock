# Konfiguracja aplikacji crossdock — skopiuj do .env i uzupełnij wartości.
# Sekrety NIGDY nie trafiają do repozytorium (.env jest w .gitignore).

# Sekret podpisujący ciasteczka sesji NiceGUI — wygeneruj np.:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
CROSSDOCK_STORAGE_SECRET=

# Hasło startowe konta admina (używane tylko przy pierwszym uruchomieniu, gdy baza jest pusta)
CROSSDOCK_ADMIN_PASSWORD=

# Ścieżka do bazy SQLite (względem katalogu projektu lub bezwzględna)
CROSSDOCK_DB_PATH=data/crossdock.db

# Adres i port serwera (0.0.0.0 = dostęp z sieci LAN)
CROSSDOCK_HOST=0.0.0.0
CROSSDOCK_PORT=8080

# Wylogowanie po bezczynności (minuty)
CROSSDOCK_SESSION_MAX_IDLE_MINUTES=60

# Domyślny termin dostawy dla zleceń bez daty (dni kalendarzowe, FR-024)
CROSSDOCK_DEFAULT_DELIVERY_DAYS=7

# Mapowanie kolumn Excela (JSON) — do podmiany po słowniku Sandry (W-02)
CROSSDOCK_EXCEL_MAPPING_PATH=config/excel_column_mapping.json

# Limit rozmiaru uploadu Excela (MB)
CROSSDOCK_UPLOAD_MAX_MB=20

# Współrzędne magazynu przeładunkowego (MVP)
CROSSDOCK_DEPOT_LATITUDE=51.176
CROSSDOCK_DEPOT_LONGITUDE=4.836

# Progi biznesowe (propozycje SRS — do potwierdzenia z zespołem)
CROSSDOCK_MIN_FILL_RATIO=0.90
CROSSDOCK_MAX_DROPS_PER_ROUTE=3

# Solver CP-SAT (T3) — limit czasu [s] i seed powtarzalności
CROSSDOCK_SOLVER_TIME_LIMIT_S=45
CROSSDOCK_SOLVER_SEED=42

# Placeholder freight rate (€/km) until Sandra's rates (W-06).
# After W-06: replace with per-vehicle-type rates + storage €/pallet/day (T7).
CROSSDOCK_COST_PER_KM=1.2

# FR-022 buffering placeholders (W-06)
CROSSDOCK_BUFFER_SAVINGS_THRESHOLD=0.15
CROSSDOCK_STORAGE_COST_PER_PALLET_DAY=2.0
CROSSDOCK_LTL_COST_MULTIPLIER=1.8
CROSSDOCK_MAX_BUFFER_DAYS=3

# Nightly SQLite backup
CROSSDOCK_BACKUP_DIR=data/backups
CROSSDOCK_BACKUP_KEEP=14
CROSSDOCK_BACKUP_HOUR=2
CROSSDOCK_BACKUP_MINUTE=30
