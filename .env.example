# Konfiguracja aplikacji crossdock — skopiuj do .env i uzupełnij wartości.
# Sekrety NIGDY nie trafiają do repozytorium (.env jest w .gitignore).

# Sekret podpisujący ciasteczka sesji NiceGUI — wygeneruj np.:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
CROSSDOCK_STORAGE_SECRET=

# Hasło startowe konta admina (używane tylko przy pierwszym uruchomieniu, gdy baza jest pusta)
CROSSDOCK_ADMIN_PASSWORD=

# Ścieżka do bazy SQLite (względem katalogu projektu lub bezwzględna)
CROSSDOCK_DB_PATH=data/crossdock.db

# Adres i port serwera (0.0.0.0 = dostęp z sieci LAN)
CROSSDOCK_HOST=0.0.0.0
CROSSDOCK_PORT=8080

# Wylogowanie po bezczynności (minuty)
CROSSDOCK_SESSION_MAX_IDLE_MINUTES=60

# Domyślny termin dostawy dla zleceń bez daty (dni kalendarzowe, FR-024)
CROSSDOCK_DEFAULT_DELIVERY_DAYS=7
